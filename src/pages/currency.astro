---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const milestones = [
  {
    year: '2017',
    text: "The UK's first official ICO — completing the FCA compliance process.",
    done: true,
    popCaption: 'The Seratio token is minted',
    popIcon:
      '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2"/>',
  },
  {
    year: '2018',
    text: 'Award winner at the Financial Times Innovation Award, represented by our lawyers Eversheds Sutherland.',
    done: true,
    popCaption: 'FT Innovation Award winner',
    popIcon:
      '<circle cx="12" cy="9" r="6"/><path d="M12 6.2 12.9 8h2l-1.5 1.4.4 2-1.8-1-1.8 1 .4-2L9.1 8h2z"/><path d="m8.6 14-1.6 7 5-2.6 5 2.6-1.6-7"/>',
  },
  {
    year: '2025',
    text: 'We launched iRWA — branded impact tokens as an instrument of the ecosystem.',
    done: true,
    popCaption: 'Branded impact tokens join the iRWA ecosystem',
    popIcon:
      '<path d="M12 2.5 20 7v10l-8 4.5L4 17V7z"/><circle cx="12" cy="12" r="2.6"/><path d="M12 9.4V5.6M14.3 13.3l3.3 1.9M9.7 13.3l-3.3 1.9"/>',
  },
  {
    year: '2027',
    text: 'Real-life roll-out of our impact currencies begins.',
    done: false,
    popCaption: 'Impact currencies enter the real economy',
    popIcon:
      '<circle cx="12" cy="12" r="7"/><path d="M2.5 12c3-3.5 16-3.5 19 0M2.5 12c3 3.5 16 3.5 19 0"/><circle cx="19.5" cy="6.5" r="1.6"/>',
  },
];
---

<BaseLayout
  title="Currency — CCEG"
  description="Money is an agent of values. CCEG's two-token currency — the Seratio® (SER) for hard financial value and the Microshare™ (MCR) for soft intangible value — makes Total Value tradable: p/e + s/e."
>
  <SiteHeader />
  <main class="currency">
    <!-- ============ Hero: statement + flipping coin ============ -->
    <section class="cur-hero">
      <div class="cur-hero-copy">
        <h1>
          <span>Money is an</span>
          <span>agent of <em>values.</em></span>
        </h1>
        <p>
          The dollar represents McDonalds, Coca-Cola and American values. Russia and Iran are
          amongst the countries that have found reliance on dollar-backed commodities problematic.
          That is why some countries now trade in Chinese Yuan, and why alternative currencies rise
          where BRICS countries can unite with greater trust. CCEG has conducted years of research
          and experimentation.
        </p>
        <blockquote class="cur-pull">
          A currency can be weaponized to articulate a particular set of values.
        </blockquote>
      </div>
      <figure class="cur-coin-stage" aria-hidden="true">
        <div class="coin">
          <div class="coin-face coin-ser">
            <span class="coin-sym">SER</span>
            <span class="coin-name">Seratio®</span>
            <span class="coin-kind">hard · financial</span>
          </div>
          <div class="coin-face coin-mcr">
            <span class="coin-sym">MCR</span>
            <span class="coin-name">Microshare™</span>
            <span class="coin-kind">soft · intangible</span>
          </div>
          <div class="coin-edge"></div>
        </div>
        <div class="coin-shadow"></div>
        <figcaption class="sr-only">
          A coin slowly turning between its two faces: SER, the Seratio, and MCR, the Microshare.
        </figcaption>
      </figure>
    </section>

    <!-- ============ Programmable money ============ -->
    <section class="cur-programmable">
      <div class="prog-copy">
        <h2>Programmable money carries ideology</h2>
        <p>
          Digital currency is programmable money — values can be integrated directly into its
          operational use. We predicted the Trump coin early on. We all know about Bitcoin,
          although people don't fully understand that it now has institutional support like gold.
          You don't have to understand how a 'Ku Klux coin' works, but you instinctively know
          whether you want to get paid in it — you will need a community who would accept it,
          otherwise it's worthless to you.
        </p>
        <p class="prog-law">Values of giver and receiver must align.</p>
      </div>
      <aside class="prog-stat" aria-label="Trump coin support">
        <span class="stat-figure">$1.4bn</span>
        <span class="stat-caption">
          of support gathered by the Trump coin — for his ideology, not any financial imperative
        </span>
      </aside>
    </section>

    <!-- ============ Two tokens / Total Value (light band) ============ -->
    <section class="cur-tokens" aria-label="The two-token currency">
      <div class="tokens-head">
        <div>
          <h2>One currency, two kinds of value</h2>
          <p class="tokens-intro">
            Years of research led to a two-token currency — and to the idea of{' '}
            <strong>Total Value</strong>.
          </p>
        </div>
        <a
          class="wp-stack"
          href="https://ccegblockchain.com/white-papers/"
          target="_blank"
          rel="noopener"
        >
          <span class="wp-sheet s3" aria-hidden="true"></span>
          <span class="wp-sheet s2" aria-hidden="true"></span>
          <span class="wp-sheet s1">
            <b>17</b>
            <span class="wp-word">whitepapers</span>
            <span class="wp-read">
              read the research
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M7 17 17 7" />
                <path d="M9 7h8v8" />
              </svg>
            </span>
          </span>
        </a>
      </div>
      <div class="tokens-split">
        <article class="token token-ser">
          <h3>Financial value</h3>
          <p>Hard, tangible, financial value — the money everyone already understands.</p>
          <span class="token-ratio">p/e</span>
          <span class="token-ratio-label">Price Earnings Ratio</span>
        </article>
        <div class="tokens-plus" aria-hidden="true">+</div>
        <article class="token token-mcr">
          <h3>Non-financial value</h3>
          <p>Soft, intangible, non-financial value — the value everyone feels.</p>
          <span class="token-ratio">s/e</span>
          <span class="token-ratio-label">Social Earnings Ratio®</span>
        </article>
      </div>
      <div class="total-value" role="img" aria-label="Total Value equals p over e plus s over e">
        <span class="tv-label">Total Value</span>
        <span class="tv-eq">= <b class="tv-pe">p/e</b> + <b class="tv-se">s/e</b></span>
      </div>
    </section>

    <!-- ============ Milestones ============ -->
    <section class="cur-milestones" aria-label="Currency milestones">
      <h2>From first ICO to impact currencies</h2>
      <p>
        We are now pioneering, in real life, the application of our impact currencies — whose value
        is index-linked to the social impact they create for the brand, whether organisation,
        project, process or even people.
      </p>
      <div class="timeline">
        <div class="timeline-track" aria-hidden="true"></div>
        {
          milestones.map((m, i) => (
            <div class:list={['milestone', 'reveal', { ahead: !m.done }]} style={`--reveal-delay: ${i * 60}`}>
              <span class="milestone-pop" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  width="34"
                  height="34"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={m.popIcon}
                />
                <span class="pop-caption">{m.popCaption}</span>
              </span>
              <span class="milestone-year">{m.year}</span>
              <span class="milestone-text">{m.text}</span>
            </div>
          ))
        }
      </div>
      <div class="cur-actions">
        <a href="mailto:info@cceg.org.uk" class="btn btn-solid">Talk to us</a>
        <a href="/" class="btn btn-ghost">Back to CCEG</a>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  /* Page-local accent: gold for hard financial value, playing against the crimson */
  .currency {
    --gold: #dfb271;
    --gold-deep: #a97c3c;
  }

  /* ---------- Hero ---------- */
  .cur-hero {
    display: flex;
    align-items: center;
    gap: clamp(28px, 5vw, 80px);
    padding: 56px var(--pad) var(--section-gap);
  }
  .cur-hero-copy {
    flex: 1 1 58%;
    display: flex;
    flex-direction: column;
    gap: 26px;
    align-items: flex-start;
  }
  .cur-hero h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(42px, 6vw, 88px);
    line-height: 1.04;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .cur-hero h1 span {
    display: block;
  }
  .cur-hero h1 em {
    font-style: normal;
    color: var(--ember);
  }
  .cur-hero-copy > p {
    margin: 0;
    font-size: 16px;
    line-height: 1.7;
    max-width: 58ch;
    color: var(--muted);
  }
  .cur-pull {
    margin: 0;
    padding: 18px 24px;
    font-family: var(--font-display);
    font-size: clamp(19px, 2.2vw, 25px);
    line-height: 1.35;
    color: var(--bone);
    background: rgba(212, 43, 39, 0.1);
    border: 1px solid rgba(212, 43, 39, 0.4);
    border-radius: 4px 28px 28px 28px;
    max-width: 24ch;
    transform: rotate(-1.2deg);
  }

  /* ---------- Coin ---------- */
  .cur-coin-stage {
    flex: 1 1 42%;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 26px;
    perspective: 1100px;
  }
  .coin {
    position: relative;
    width: clamp(200px, 24vw, 300px);
    height: clamp(200px, 24vw, 300px);
    transform-style: preserve-3d;
    animation: coinflip 14s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }
  .coin-face {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    backface-visibility: hidden;
    text-align: center;
    padding: 24px;
  }
  .coin-ser {
    background:
      radial-gradient(circle at 32% 28%, rgba(255, 245, 224, 0.5), transparent 45%),
      linear-gradient(135deg, var(--gold), var(--gold-deep));
    border: 6px solid rgba(255, 240, 210, 0.35);
    box-shadow: 0 24px 60px rgba(223, 178, 113, 0.28);
  }
  .coin-mcr {
    transform: rotateY(180deg);
    background: rgba(232, 221, 210, 0.05);
    border: 3px dashed rgba(232, 221, 210, 0.55);
  }
  .coin-sym {
    font-family: var(--font-display);
    font-size: clamp(44px, 5.4vw, 66px);
    line-height: 1;
  }
  .coin-ser .coin-sym {
    color: #241503;
  }
  .coin-mcr .coin-sym {
    color: var(--bone);
  }
  .coin-name {
    font-size: 14px;
    font-weight: 700;
  }
  .coin-ser .coin-name {
    color: rgba(36, 21, 3, 0.85);
  }
  .coin-mcr .coin-name {
    color: var(--red-300);
  }
  .coin-kind {
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 700;
  }
  .coin-ser .coin-kind {
    color: rgba(36, 21, 3, 0.6);
  }
  .coin-mcr .coin-kind {
    color: var(--muted);
  }
  .coin-shadow {
    width: 62%;
    height: 16px;
    border-radius: 50%;
    background: radial-gradient(ellipse, rgba(0, 0, 0, 0.55), transparent 70%);
    animation: coinshadow 14s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  /* ---------- Programmable money ---------- */
  .cur-programmable {
    display: flex;
    align-items: stretch;
    gap: clamp(24px, 4vw, 56px);
    padding: 0 var(--pad) var(--section-gap);
  }
  .prog-copy {
    flex: 1 1 60%;
  }
  .cur-programmable h2,
  .cur-tokens h2,
  .cur-milestones h2 {
    margin: 0 0 18px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(28px, 3.6vw, 42px);
    line-height: 1.12;
    color: var(--text);
  }
  .prog-copy p {
    margin: 0 0 16px;
    font-size: 15.5px;
    line-height: 1.7;
    max-width: 60ch;
    color: var(--muted);
  }
  .prog-law {
    font-family: var(--font-display);
    font-size: 21px;
    color: var(--red-300);
  }
  .prog-stat {
    flex: 1 1 40%;
    max-width: 380px;
    align-self: center;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: clamp(28px, 3.5vw, 44px);
    border-radius: 28px 28px 28px 4px;
    background:
      radial-gradient(ellipse at 20% 0%, rgba(223, 178, 113, 0.16), transparent 60%),
      rgba(232, 221, 210, 0.05);
    border: 1px solid rgba(223, 178, 113, 0.4);
    transform: rotate(1deg);
  }
  .stat-figure {
    font-family: var(--font-display);
    font-size: clamp(48px, 5.5vw, 72px);
    line-height: 1;
    color: var(--gold);
  }
  .stat-caption {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--muted);
  }

  /* ---------- Two tokens: the bright band ---------- */
  .cur-tokens {
    --ink: #241514;
    --ink-soft: rgba(58, 38, 33, 0.78);
    margin: 0 var(--pad) var(--section-gap);
    padding: clamp(36px, 4.5vw, 64px);
    border-radius: 40px;
    background:
      radial-gradient(ellipse at 85% -10%, rgba(212, 43, 39, 0.14), transparent 55%),
      linear-gradient(180deg, #f8f1e8, #efe2d1);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45);
  }
  .cur-tokens h2 {
    color: var(--ink);
  }
  .tokens-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(24px, 4vw, 56px);
    margin-bottom: 40px;
  }
  .tokens-intro {
    margin: 0;
    font-size: 16px;
    line-height: 1.65;
    max-width: 42ch;
    color: var(--ink-soft);
  }
  .tokens-intro strong {
    color: var(--red);
  }

  /* Whitepapers: a clickable stack of sheets */
  .wp-stack {
    position: relative;
    flex: none;
    width: 176px;
    height: 148px;
    text-decoration: none;
    transition: transform 0.25s ease-out;
  }
  .wp-stack:hover {
    opacity: 1;
    transform: translateY(-4px) rotate(0.6deg);
  }
  .wp-stack:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 5px;
    border-radius: 12px;
  }
  .wp-sheet {
    position: absolute;
    inset: 0;
    border-radius: 10px;
    background: #fffdf9;
    border: 1px solid rgba(88, 60, 40, 0.22);
    box-shadow: 0 10px 24px rgba(60, 35, 20, 0.18);
  }
  .wp-sheet.s3 {
    transform: rotate(-4deg) translate(-5px, 5px);
    background: #f3e9db;
  }
  .wp-sheet.s2 {
    transform: rotate(2.5deg) translate(4px, 2px);
    background: #faf4ea;
  }
  .wp-sheet.s1 {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 1px;
    padding: 16px 20px;
  }
  .wp-sheet.s1 b {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 52px;
    line-height: 1;
    color: var(--red);
  }
  .wp-word {
    font-size: 13.5px;
    font-weight: 700;
    color: #241514;
  }
  .wp-read {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-top: 8px;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 700;
    color: rgba(58, 38, 33, 0.6);
  }
  .wp-stack:hover .wp-read {
    color: var(--red);
  }
  .tokens-split {
    display: flex;
    align-items: stretch;
    gap: clamp(14px, 2vw, 24px);
  }
  .token {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: clamp(26px, 3vw, 40px);
    border-radius: 28px;
  }
  .token-ser {
    background:
      radial-gradient(ellipse at 80% 0%, rgba(223, 178, 113, 0.35), transparent 55%),
      rgba(255, 251, 244, 0.75);
    border: 1px solid rgba(169, 124, 60, 0.5);
  }
  .token-mcr {
    background: rgba(255, 251, 244, 0.45);
    border: 2px dashed rgba(120, 84, 70, 0.45);
  }
  .token h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(21px, 2.3vw, 27px);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink);
  }
  .token p {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 34ch;
  }
  .token-ratio {
    margin-top: auto;
    padding-top: 18px;
    font-family: var(--font-display);
    font-size: clamp(36px, 4vw, 52px);
    line-height: 1;
  }
  .token-ser .token-ratio {
    color: var(--gold-deep);
  }
  .token-mcr .token-ratio {
    color: var(--red);
  }
  .token-ratio-label {
    font-size: 12px;
    color: var(--ink-soft);
  }
  .tokens-plus {
    align-self: center;
    font-family: var(--font-display);
    font-size: clamp(36px, 4vw, 56px);
    color: rgba(58, 38, 33, 0.5);
    flex: none;
  }
  .total-value {
    margin-top: 28px;
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
    padding: clamp(24px, 3vw, 36px);
    border-radius: 999px;
    background:
      radial-gradient(ellipse at 25% 0%, rgba(255, 255, 255, 0.16), transparent 55%),
      linear-gradient(135deg, var(--red), var(--red-600));
    box-shadow: 0 18px 44px rgba(156, 24, 21, 0.35);
  }
  .tv-label {
    font-family: var(--font-display);
    font-size: clamp(24px, 3vw, 38px);
    color: #fff;
  }
  .tv-eq {
    font-family: var(--font-display);
    font-size: clamp(24px, 3vw, 38px);
    color: rgba(255, 255, 255, 0.85);
  }
  .tv-eq b {
    font-weight: 400;
  }
  .tv-pe {
    color: #ffdfae;
  }
  .tv-se {
    color: var(--red-200);
  }

  /* ---------- Milestones (crimson wash) ---------- */
  .cur-milestones {
    padding: clamp(36px, 4.5vw, 56px) var(--pad) var(--section-gap);
    background: radial-gradient(ellipse at 12% 0%, rgba(212, 43, 39, 0.13), transparent 55%);
  }
  .cur-milestones > p {
    margin: 0 0 40px;
    font-size: 15.5px;
    line-height: 1.7;
    max-width: 64ch;
    color: var(--muted);
  }
  .timeline {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    padding-top: 26px;
  }
  .timeline-track {
    position: absolute;
    top: 5px;
    left: 6px;
    right: 6px;
    height: 2px;
    background: linear-gradient(
      90deg,
      var(--gold) 0%,
      var(--red) 68%,
      rgba(232, 221, 210, 0.22) 78%,
      rgba(232, 221, 210, 0.22) 100%
    );
  }
  .milestone {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .milestone::before {
    content: '';
    position: absolute;
    top: -26px;
    left: 0;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--red);
  }
  .milestone:first-child::before {
    background: var(--gold);
  }
  .milestone.ahead::before {
    background: var(--bg);
    border: 2px solid rgba(232, 221, 210, 0.45);
  }
  .milestone-year {
    font-family: var(--font-display);
    font-size: 26px;
    color: var(--bone);
  }
  .milestone.ahead .milestone-year {
    color: var(--red-300);
  }
  .milestone-text {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--muted);
    max-width: 30ch;
  }

  /* Pop-up card: a little bone sheet that appears over each milestone */
  .milestone-pop {
    position: absolute;
    bottom: calc(100% + 32px);
    left: -6px;
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 12px;
    width: max-content;
    max-width: 240px;
    padding: 14px 18px;
    border-radius: 16px 16px 16px 4px;
    background: linear-gradient(180deg, #faf3e9, #efe2d1);
    color: var(--red-600);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
    opacity: 0;
    transform: translateY(10px) scale(0.92) rotate(-1deg);
    transform-origin: bottom left;
    transition:
      opacity 0.25s ease-out,
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }
  .milestone-pop svg {
    flex: none;
  }
  .milestone.ahead .milestone-pop {
    color: var(--gold-deep);
  }
  .pop-caption {
    font-size: 12.5px;
    line-height: 1.45;
    font-weight: 700;
    color: #3a2621;
  }
  /* Desktop: pop on hover */
  @media (hover: hover) {
    .milestone:hover .milestone-pop {
      opacity: 1;
      transform: translateY(0) scale(1) rotate(-1deg);
    }
  }
  /* Touch: pop when the milestone scrolls into view (reveal observer adds is-visible) */
  @media (hover: none) {
    .milestone-pop {
      position: static;
      order: 3;
      margin-top: 10px;
      align-self: flex-start;
      transition-delay: 0.35s;
    }
    html.js .milestone.is-visible .milestone-pop,
    html:not(.js) .milestone-pop {
      opacity: 1;
      transform: none;
    }
  }
  .cur-actions {
    margin-top: 44px;
    display: flex;
    gap: 14px;
