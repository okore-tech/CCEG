---
import '@fontsource/caprasimo';
import '@fontsource/figtree/400.css';
import '@fontsource/figtree/600.css';
import '@fontsource/figtree/700.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'CCEG — Centre for Citizenship, Enterprise & Governance',
  description = "The world's leading think tank on the movement of non-financial value. Research, sentiment measurement, blockchain transactions and real-economy implementation — making the intangible tangible since 2011.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#100f10" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"></div>
    <div class="page">
      <!-- Ambient background: aurora washes + rising ember particles -->
      <div class="bg-auras" aria-hidden="true">
        <div class="aura aura-1"></div>
        <div class="aura aura-2"></div>
        <div class="aura aura-3"></div>
      </div>
      <div class="bg-particles" aria-hidden="true">
        <span class="particle p1"></span>
        <span class="particle p2"></span>
        <span class="particle p3"></span>
        <span class="particle p4"></span>
        <span class="particle p5"></span>
        <span class="particle p6"></span>
      </div>

      <div class="page-content">
        <slot />
      </div>
    </div>

    <script>
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Scroll progress bar
      const bar = document.querySelector<HTMLElement>('.scroll-progress');
      let ticking = false;
      const updateBar = () => {
        const max = document.documentElement.scrollHeight - innerHeight;
        const progress = max > 0 ? Math.min(scrollY / max, 1) : 0;
        bar?.style.setProperty('transform', `scaleX(${progress})`);
        ticking = false;
      };
      addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(updateBar);
          }
        },
        { passive: true }
      );
      updateBar();

      // Scroll reveals
      const revealEls = document.querySelectorAll<HTMLElement>('.reveal');
      if (reduceMotion || !('IntersectionObserver' in window)) {
        revealEls.forEach((el) => el.classList.add('is-visible'));
      } else {
        const revealObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                revealObserver.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -40px' }
        );
        revealEls.forEach((el) => revealObserver.observe(el));
      }

      // Count-up stats (initial markup holds the final value for no-JS/SEO)
      const counters = document.querySelectorAll<HTMLElement>('[data-countup]');
      const runCount = (el: HTMLElement) => {
        const target = Number(el.dataset.countup);
        const duration = 1400;
        const start = performance.now();
        const step = (now: number) => {
          const k = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - k, 3);
          el.textContent = Math.round(target * eased).toLocaleString('en-GB');
          if (k < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };
      if (!reduceMotion && 'IntersectionObserver' in window) {
        const countObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                runCount(entry.target as HTMLElement);
                countObserver.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.6 }
        );
        counters.forEach((el) => countObserver.observe(el));
      }

      // Pause looping animations while their section is offscreen
      const scopes = document.querySelectorAll('[data-animate-scope]');
      if ('IntersectionObserver' in window) {
        const pauseObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              entry.target.classList.toggle('anim-paused', !entry.isIntersecting);
            }
          },
          { rootMargin: '100px' }
        );
        scopes.forEach((scope) => pauseObserver.observe(scope));
      }
    </script>
  </body>
</html>
