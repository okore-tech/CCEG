---
const navLinks = [
  { label: 'iRWA', href: '#', active: true },
  { label: 'Genome of Values', href: '#' },
  { label: 'Research', href: '#' },
  { label: 'Education', href: '#' },
  { label: 'Leadership', href: '#' },
  { label: 'Advisory Board', href: '#' },
];
---

<header class="site-header">
  <div class="brand">
    <a href="/" class="brand-lockup" aria-label="CCEG home">
      <span class="brand-mark" aria-hidden="true">
        <span class="mark-gas"></span>
        <span class="mark-solid"></span>
        <span class="mark-dot"></span>
      </span>
      <span class="brand-word">CCEG</span>
    </a>
    <span class="brand-tag">Centre for Citizenship, Enterprise &amp; Governance</span>
  </div>

  <button
    class="nav-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="main-nav"
    aria-label="Menu"
  >
    <span></span><span></span><span></span>
  </button>

  <nav class="main-nav" id="main-nav" aria-label="Primary">
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[{ 'is-active': link.active }]}
          aria-current={link.active ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))
    }
    <div class="nav-secondary">
      <a href="#">Members' area</a>
      <a href="#">Social Value &amp; Intangibles Review</a>
    </div>
    <a href="#contact" class="nav-cta">Contact</a>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px var(--pad);
    gap: 24px;
    border-bottom: 1px solid var(--line);
    background: rgba(16, 15, 16, 0.78);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 16px;
    min-width: 0;
  }
  .brand-lockup {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }
  .brand-mark {
    position: relative;
    display: block;
    width: 44px;
    height: 39px;
    flex: none;
  }
  .mark-gas {
    position: absolute;
    left: 0;
    top: 0;
    width: 27px;
    height: 27px;
    border-radius: 50%;
    background: radial-gradient(circle at 38% 35%, #f0857f, #d42b27 58%, transparent 74%);
    filter: blur(4px);
    opacity: 0.9;
  }
  .mark-solid {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 24px;
    height: 24px;
    border-radius: 8px;
    background: linear-gradient(135deg, #e8433c, #9c1815);
  }
  .mark-dot {
    position: absolute;
    right: 9px;
    bottom: 9px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #f6f2ef;
  }
  .brand-word {
    font: 700 24px/1 var(--font-body);
    letter-spacing: 0.02em;
    color: var(--text);
  }
  .brand-tag {
    font-size: 11.5px;
    line-height: 1.35;
    max-width: 180px;
    color: var(--muted);
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .main-nav a {
    text-decoration: none;
    color: var(--muted);
    font-size: 13px;
    font-weight: 700;
    padding: 10px 15px;
    border-radius: 999px;
    white-space: nowrap;
    transition:
      background-color 0.2s ease-out,
      color 0.2s ease-out;
  }
  .main-nav a:not(.is-active):not(.nav-cta):hover {
    opacity: 1;
    color: var(--text);
    background: rgba(246, 242, 239, 0.07);
  }
  .main-nav a.is-active {
    color: var(--text);
    background: rgba(232, 221, 210, 0.12);
  }
  .main-nav a.nav-cta {
    color: #fff;
    background: var(--red);
    padding: 11px 20px;
    margin-left: 10px;
  }
  .main-nav a.nav-cta:hover {
    opacity: 1;
    background: var(--ember);
  }
  .nav-secondary {
    display: none;
  }

  .nav-toggle {
    display: none;
    background: none;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 10px;
    cursor: pointer;
  }
  .nav-toggle span {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--text);
    margin: 4px 0;
    border-radius: 2px;
    transition: transform 0.25s, opacity 0.25s;
  }

  @media (max-width: 1100px) {
    .brand-tag {
      display: none;
    }
    .nav-toggle {
      display: block;
    }
    .main-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      z-index: 20;
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
      padding: 14px var(--pad) 20px;
      background: var(--surface);
      border-bottom: 1px solid var(--line);
      box-shadow: 0 24px 40px rgba(0, 0, 0, 0.45);
    }
    .site-header.nav-open .main-nav {
      display: flex;
    }
    .main-nav a {
      padding: 13px 16px;
    }
    .main-nav a.nav-cta {
      margin: 8px 0 0;
      text-align: center;
    }
    .nav-secondary {
      display: flex;
      flex-direction: column;
      gap: 2px;
      margin-top: 8px;
      padding-top: 8px;
      border-top: 1px solid var(--line);
    }
    .nav-secondary a {
      font-weight: 600;
      font-size: 12.5px;
    }
    .site-header.nav-open .nav-toggle span:nth-child(1) {
      transform: translateY(6px) rotate(45deg);
    }
    .site-header.nav-open .nav-toggle span:nth-child(2) {
      opacity: 0;
    }
    .site-header.nav-open .nav-toggle span:nth-child(3) {
      transform: translateY(-6px) rotate(-45deg);
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header')!;
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle')!;

  toggle.addEventListener('click', () => {
    const open = header.classList.toggle('nav-open');
    toggle.setAttribute('aria-expanded', String(open));
  });

  document.querySelectorAll('.main-nav a').forEach((link) => {
    link.addEventListener('click', () => {
      header.classList.remove('nav-open');
      toggle.setAttribute('aria-expanded', 'false');
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && header.classList.contains('nav-open')) {
      header.classList.remove('nav-open');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.focus();
    }
  });
</script>
