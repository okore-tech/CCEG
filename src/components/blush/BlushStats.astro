---
const stats = [
  { number: '2011', label: 'est. at a British university', variant: 'stat-white', tilt: '-2deg' },
  {
    number: '320,000',
    countup: 320000,
    label: 'members worldwide',
    variant: 'stat-pink',
    tilt: '1.5deg',
    highlight: true,
  },
  { number: '15', countup: 15, label: 'years of applied research', variant: 'stat-white', tilt: '-1deg' },
];
---

<section class="stats-band" aria-label="CCEG in numbers">
  <div class="stats">
    {
      stats.map((stat, i) => (
        <div class={`stat ${stat.variant} reveal`} style={`--tilt: ${stat.tilt}; --reveal-delay: ${i * 40}`}>
          <span
            class:list={['stat-number', { 'stat-number-red': stat.highlight }]}
            data-countup={stat.countup}
          >
            {stat.number}
          </span>
          <span class="stat-label">{stat.label}</span>
        </div>
      ))
    }
  </div>
  <figure class="quote-bubble reveal" style="--reveal-delay: 140">
    <blockquote>"A currency of non-financial value at parity with financial currency."</blockquote>
    <span class="bubble-tail" aria-hidden="true"></span>
  </figure>
</section>

<style>
  .stats-band {
    display: flex;
    align-items: center;
    gap: 44px;
    padding: 30px var(--pad) 70px;
  }
  .stats {
    display: flex;
    gap: 26px;
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
    border-radius: 22px;
    padding: 22px 26px;
    transform: rotate(var(--tilt));
  }
  .stat-white {
    background: #ffffff;
    border: 2px solid var(--line);
    box-shadow: 0 8px 0 var(--pink-50);
  }
  .stat-pink {
    background: var(--pink-100);
    box-shadow: 0 8px 0 var(--pink-200);
  }
  .stat-number {
    font-family: var(--font-display);
    font-size: 36px;
    line-height: 1.1;
    color: var(--ink);
  }
  .stat-number[data-countup] {
    font-variant-numeric: tabular-nums;
  }
  .stat-number-red {
    color: var(--red);
  }
  .stat-label {
    font-size: 13px;
    color: var(--muted);
  }
  .stat-pink .stat-label {
    color: var(--muted-deep);
  }

  html.js .stat.reveal {
    transform: rotate(var(--tilt)) translateY(10px);
  }
  html.js .stat.reveal.is-visible {
    transform: rotate(var(--tilt));
  }

  .quote-bubble {
    position: relative;
    flex: 1;
    margin: 0;
    background: #ffffff;
    border: 2px solid #ffd7dd;
    border-radius: 26px;
    padding: 26px 32px;
  }
  .quote-bubble blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: 19px;
    line-height: 1.45;
    color: var(--ink);
  }
  .bubble-tail {
    position: absolute;
    left: 46px;
    bottom: -14px;
    width: 26px;
    height: 26px;
    background: #ffffff;
    border-right: 2px solid #ffd7dd;
    border-bottom: 2px solid #ffd7dd;
    transform: rotate(45deg);
  }

  @media (max-width: 1100px) {
    .stats-band {
      flex-direction: column;
      align-items: stretch;
      gap: 34px;
    }
    .stats {
      justify-content: space-between;
      flex-wrap: wrap;
    }
  }
  @media (max-width: 560px) {
    .stats {
      flex-direction: column;
      gap: 18px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    html.js .stat.reveal,
    html.js .stat.reveal.is-visible {
      transform: rotate(var(--tilt));
    }
  }
</style>
