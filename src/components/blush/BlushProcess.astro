---
const steps = [
  {
    num: '01',
    numColor: 'var(--rose)',
    title: 'Research',
    desc: 'the science of how non-financial value behaves',
    variant: 'card-white',
    tilt: '-1.2deg',
  },
  {
    num: '02',
    numColor: 'var(--rose-deep)',
    title: 'Measurement',
    desc: 'a number where there was a feeling, via sentiment analysis',
    variant: 'card-pink',
    tilt: '1deg',
  },
  {
    num: '03',
    numColor: 'var(--red)',
    title: 'Transactions',
    desc: 'blockchain gives measured value permanence',
    variant: 'card-outline',
    tilt: '-0.8deg',
  },
  {
    num: '04',
    numColor: 'var(--red-shadow)',
    title: 'Implementation',
    desc: 'retail · corporate · government — value in the real economy',
    variant: 'card-red',
    tilt: '1.4deg',
  },
];
---

<section class="process" id="what-we-do" aria-label="What we do">
  <div class="process-heading">
    <h2>From feeling to holding</h2>
    <span class="chip chip-salmon tilt">how it works</span>
  </div>
  <ol class="process-grid">
    {
      steps.map((step, i) => (
        <li
          class={`card ${step.variant} reveal`}
          style={`--tilt: ${step.tilt}; --reveal-delay: ${i * 60}`}
        >
          <span class="card-num" style={`color: ${step.numColor}`}>{step.num}</span>
          <span class="card-title">{step.title}</span>
          <span class="card-desc">{step.desc}</span>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .process {
    padding: 70px var(--pad) 50px;
  }
  .process-heading {
    display: flex;
    align-items: baseline;
    gap: 18px;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }
  .process-heading h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(30px, 3.4vw, 40px);
    color: var(--ink);
  }
  .tilt {
    transform: rotate(-2deg);
  }

  .process-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 26px;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    border-radius: 26px;
    padding: 28px;
    transform: rotate(var(--tilt));
    transition:
      transform 0.25s ease-out,
      box-shadow 0.25s ease-out;
  }
  .card:hover {
    transform: rotate(0deg) translateY(-4px);
  }
  .card-white {
    background: #ffffff;
    border: 2px solid #ffd7dd;
    box-shadow: 0 10px 0 var(--line);
  }
  .card-pink {
    background: var(--pink-50);
    border: 2px solid #ffd7dd;
    box-shadow: 0 10px 0 #ffd7dd;
  }
  .card-outline {
    background: #ffffff;
    border: 2px solid var(--red);
    box-shadow: 0 10px 0 var(--red-shadow);
  }
  .card-red {
    background: var(--red);
    box-shadow: 0 10px 0 #ffb3bd;
  }
  .card-num {
    font-family: var(--font-display);
    font-size: 44px;
    line-height: 1;
  }
  .card-title {
    font-size: 16px;
    font-weight: 800;
    color: var(--ink);
  }
  .card-red .card-title,
  .card-red .card-desc {
    color: #ffffff;
  }
  .card-desc {
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
  }

  /* html.js .reveal sets its own transform — recompose the tilt on top */
  html.js .card.reveal {
    transform: rotate(var(--tilt)) translateY(10px);
  }
  html.js .card.reveal.is-visible {
    transform: rotate(var(--tilt));
  }
  html.js .card.reveal.is-visible:hover {
    transform: rotate(0deg) translateY(-4px);
  }

  @media (max-width: 980px) {
    .process-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .process-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .card:hover,
    html.js .card.reveal,
    html.js .card.reveal.is-visible,
    html.js .card.reveal.is-visible:hover {
      transform: rotate(var(--tilt));
    }
  }
</style>
