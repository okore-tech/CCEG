---

---

<section class="blush-hero" data-animate-scope>
  <div class="hero-content">
    <p class="hero-badge-row">
      <span class="chip chip-salmon tilt-l">World's leading think tank on non-financial value</span>
    </p>
    <h1 class="hero-title">
      We made the <span class="word-ghost">intangible</span>
      <span class="word-solid">tangible.<svg class="squiggle" viewBox="0 0 220 20" aria-hidden="true"><path class="squiggle-path" d="M4 12 q 14 -10 28 0 t 28 0 t 28 0 t 28 0 t 28 0 t 28 0 t 28 0" fill="none" stroke="#d42b27" stroke-width="5" stroke-linecap="round"></path></svg></span>
    </h1>
    <p class="hero-copy">
      Love, trust, care and purpose — researched, measured by sentiment, transacted on blockchain,
      implemented in the real economy since 2011.
    </p>
    <div class="hero-actions">
      <a href="#what-we-do" class="btn btn-solid">Discover iRWA</a>
      <a href="#join" class="btn btn-ghost">Meet the members</a>
    </div>

    <!-- Compact story (narrow screens): word cycles, lands as its tangible tile -->
    <div class="hero-pair" aria-hidden="true">
      <div class="pair-words">
        <span class="pair-word pw-1">love</span>
        <span class="pair-word pw-2">trust</span>
        <span class="pair-word pw-3">care</span>
        <span class="pair-word pw-4">purpose</span>
      </div>
      <svg class="pair-arrow" width="44" height="22" viewBox="0 0 60 24" fill="none" aria-hidden="true">
        <path d="M4 14 C 20 6, 34 6, 50 12" stroke="#f0857f" stroke-width="3" stroke-linecap="round" stroke-dasharray="1 7"></path>
        <path d="M43 6 L 52 12 L 42 17" stroke="#f0857f" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      <div class="pair-tiles">
        <div class="tile tile-1"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M17 8h1a4 4 0 1 1 0 8h-1"></path><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"></path><line x1="6" y1="2" x2="6" y2="4"></line><line x1="10" y1="2" x2="10" y2="4"></line><line x1="14" y1="2" x2="14" y2="4"></line></svg></div>
        <div class="tile tile-2"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#3a2226" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="m3 10.5 9-7.5 9 7.5"></path><path d="M5 10v10h14V10"></path><path d="M10 20v-6h4v6"></path></svg></div>
        <div class="tile tile-3"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16a8 8 0 0 1-16 0Z"></path><path d="M9 8c0-1.5 1-2 1-3"></path><path d="M14 8c0-1.5 1-2 1-3"></path></svg></div>
        <div class="tile tile-4"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="6" rx="7" ry="3"></ellipse><path d="M5 6v6c0 1.66 3.13 3 7 3s7-1.34 7-3V6"></path><path d="M5 12v6c0 1.66 3.13 3 7 3s7-1.34 7-3v-6"></path></svg></div>
      </div>
    </div>
    <div class="hero-pair-captions" aria-hidden="true">
      <span class="pair-caption cap-1">love became a coffee</span>
      <span class="pair-caption cap-2">trust became a home</span>
      <span class="pair-caption cap-3">care became a meal</span>
      <span class="pair-caption cap-4">purpose became a pension</span>
    </div>
  </div>

  <!-- Desktop story layer: the words orbit in from the margins and land on the tile below -->
  <div class="hero-anim" aria-hidden="true">
    <span class="orbit-word ow-love"><span class="ow-inner">love</span></span>
    <span class="orbit-word ow-trust"><span class="ow-inner">trust</span></span>
    <span class="orbit-word ow-care"><span class="ow-inner">care</span></span>
    <span class="orbit-word ow-purpose"><span class="ow-inner">purpose</span></span>

    <div class="landing">
      <div class="landing-glow"></div>
      <span class="landing-label">tangible</span>
      <div class="landing-tiles">
        <div class="tile lt-1"><svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M17 8h1a4 4 0 1 1 0 8h-1"></path><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"></path><line x1="6" y1="2" x2="6" y2="4"></line><line x1="10" y1="2" x2="10" y2="4"></line><line x1="14" y1="2" x2="14" y2="4"></line></svg></div>
        <div class="tile lt-2"><svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="#3a2226" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="m3 10.5 9-7.5 9 7.5"></path><path d="M5 10v10h14V10"></path><path d="M10 20v-6h4v6"></path></svg></div>
        <div class="tile lt-3"><svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16a8 8 0 0 1-16 0Z"></path><path d="M9 8c0-1.5 1-2 1-3"></path><path d="M14 8c0-1.5 1-2 1-3"></path></svg></div>
        <div class="tile lt-4"><svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="6" rx="7" ry="3"></ellipse><path d="M5 6v6c0 1.66 3.13 3 7 3s7-1.34 7-3V6"></path><path d="M5 12v6c0 1.66 3.13 3 7 3s7-1.34 7-3v-6"></path></svg></div>
      </div>
      <div class="landing-captions">
        <span class="pair-caption lc-1">love became a coffee</span>
        <span class="pair-caption lc-2">trust became a home</span>
        <span class="pair-caption lc-3">care became a meal</span>
        <span class="pair-caption lc-4">purpose became a pension</span>
      </div>
    </div>
  </div>
</section>

<style>
  .blush-hero {
    position: relative;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 22px;
    padding: 48px var(--pad) 40px;
  }
  .hero-badge-row {
    margin: 0;
  }
  .tilt-l {
    transform: rotate(-3deg);
    display: inline-block;
  }
  .hero-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(46px, 6.4vw, 88px);
    line-height: 1.04;
    letter-spacing: -0.01em;
    color: var(--ink);
    max-width: 880px;
  }
  /* Gradient flash sweeps across the ghost word (twice, then still)... */
  .word-ghost {
    color: transparent;
    -webkit-text-stroke: 2.5px var(--ghost);
    background: linear-gradient(
      105deg,
      rgba(232, 86, 109, 0) 30%,
      rgba(232, 86, 109, 0.65) 45%,
      rgba(255, 178, 122, 0.6) 52%,
      rgba(255, 178, 122, 0) 70%
    );
    background-size: 260% 100%;
    background-position: 120% 0;
    -webkit-background-clip: text;
    background-clip: text;
    animation: ghostflash 6s ease-in-out 2;
  }
  /* ...and bumps "tangible." on its way out */
  .word-solid {
    position: relative;
    display: inline-block;
    color: var(--red);
    transform: rotate(-2deg);
    animation: tangbump 6s ease-in-out 2;
  }
  .squiggle {
    position: absolute;
    left: 2px;
    bottom: -0.16em;
    width: 100%;
    height: 0.22em;
  }
  /* The underline draws itself once the bumping settles */
  .squiggle-path {
    stroke-dasharray: 260;
    stroke-dashoffset: 260;
    animation: squiggledraw 0.9s ease-out 12.15s forwards;
  }

  @keyframes ghostflash {
    0% { background-position: 120% 0; filter: blur(0); }
    30% { filter: blur(2.5px); }
    50% { background-position: -40% 0; filter: blur(0); }
    100% { background-position: -40% 0; filter: blur(0); }
  }
  @keyframes tangbump {
    0%, 48% { transform: rotate(-2deg) scale(1) translateY(0); }
    54% { transform: rotate(-4.5deg) scale(1.1) translateY(-7px); }
    62% { transform: rotate(-0.5deg) scale(0.97) translateY(2px); }
    70%, 100% { transform: rotate(-2deg) scale(1) translateY(0); }
  }
  @keyframes squiggledraw {
    to { stroke-dashoffset: 0; }
  }
  .hero-copy {
    margin: 0;
    font-size: 17px;
    line-height: 1.65;
    max-width: 560px;
    color: var(--muted);
  }
  .hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
  }

  /* ---------- Shared tile look ---------- */
  .tile {
    position: absolute;
    inset: 0;
    opacity: 0;
    border-radius: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: pairpop 36s ease-out infinite;
  }
  .tile-1, .lt-1 { background: var(--red);      box-shadow: 0 9px 0 var(--red-shadow); }
  .tile-2, .lt-2 { background: var(--pink-100); box-shadow: 0 9px 0 var(--pink-200); animation-delay: 9s; }
  .tile-3, .lt-3 { background: var(--salmon);   box-shadow: 0 9px 0 var(--pink-200); animation-delay: 18s; }
  .tile-4, .lt-4 { background: var(--rose-deep); box-shadow: 0 9px 0 var(--red-shadow); animation-delay: 27s; }

  .pair-caption {
    position: absolute;
    inset: 0;
    opacity: 0;
    text-align: center;
    font-size: 13px;
    font-weight: 800;
    animation: pairpop 36s ease-out infinite;
  }
  .cap-1, .lc-1 { color: var(--rose-deep); }
  .cap-2, .lc-2 { color: var(--muted-deep); animation-delay: 9s; }
  .cap-3, .lc-3 { color: var(--rose-deep); animation-delay: 18s; }
  .cap-4, .lc-4 { color: var(--muted-deep); animation-delay: 27s; }

  /* ---------- Desktop orbit layer ---------- */
  .hero-anim {
    display: none;
  }

  @media (min-width: 1240px) {
    .blush-hero {
      height: 780px;
    }
    .hero-content {
      padding-top: 56px;
    }
    .hero-pair,
    .hero-pair-captions {
      display: none;
    }
    .hero-anim {
      display: block;
      position: absolute;
      left: 50%;
      top: 0;
      width: 1200px;
      height: 100%;
      transform: translateX(-50%);
      pointer-events: none;
    }

    .orbit-word {
      position: absolute;
      left: 0;
      top: 0;
      font-family: var(--font-display);
      font-size: 27px;
      border-radius: 999px;
      padding: 9px 22px;
      offset-rotate: 0deg;
      animation: wordorbit 36s ease-in-out infinite;
    }
    /* Idle life while resting (outer span flies, inner one bobs) */
    .ow-inner {
      display: inline-block;
      animation: owbob 3.4s ease-in-out infinite alternate;
    }
    .ow-trust .ow-inner { animation-delay: 0.7s; }
    .ow-care .ow-inner { animation-delay: 1.3s; }
    .ow-purpose .ow-inner { animation-delay: 1.9s; }
    .ow-love {
      color: var(--rose);
      background: #ffffff;
      border: 2px solid var(--red-shadow);
      box-shadow: 0 6px 0 var(--line);
      offset-path: path('M150,150 C 40,330 240,600 585,650');
    }
    .ow-trust {
      color: #b0743f;
      background: #fff4ea;
      border: 2px solid #ffdfc4;
      box-shadow: 0 6px 0 #ffe9d9;
      offset-path: path('M1044,146 C 1170,330 940,610 618,650');
      animation-delay: 9s;
    }
    .ow-care {
      color: var(--muted-deep);
      background: #ffffff;
      border: 2px solid var(--line);
      box-shadow: 0 6px 0 var(--pink-50);
      offset-path: path('M118,420 C 110,580 330,655 585,656');
      animation-delay: 18s;
    }
    .ow-purpose {
      color: var(--rose);
      background: var(--pink-50);
      box-shadow: 0 6px 0 var(--pink-100);
      offset-path: path('M1072,430 C 1090,600 850,668 618,655');
      animation-delay: 27s;
    }

    .landing {
      position: absolute;
      left: 50%;
      bottom: 10px;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
      width: 220px;
    }
    /* Soft halo that pulses on every touchdown (tiles pop at 22/47/72/97%) */
    .landing-glow {
      position: absolute;
      left: 50%;
      top: 46px;
      transform: translateX(-50%);
      width: 190px;
      height: 100px;
      border-radius: 50%;
      background: radial-gradient(ellipse, rgba(240, 133, 127, 0.55), transparent 70%);
      filter: blur(16px);
      opacity: 0.35;
      animation: landglow 36s ease-in-out infinite;
    }
    .landing-tiles,
    .landing-captions,
    .landing-label {
      position: relative;
      z-index: 1;
    }
    .landing-label {
      font-size: 11px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      font-weight: 800;
      color: var(--red);
    }
    .landing-tiles {
      position: relative;
      width: 104px;
      height: 104px;
    }
    .landing-captions {
      position: relative;
      width: 220px;
      height: 20px;
    }
  }

  /* The orbit: rest in the margins, dissolve into motion (crimson-style blur), land on the tile */
  @keyframes wordorbit {
    0% { offset-distance: 0%; opacity: 1; transform: scale(1); filter: blur(0); letter-spacing: 0.02em; }
    4% { offset-distance: 0%; opacity: 1; transform: scale(1.07); filter: blur(3.5px); letter-spacing: 0.16em; }
    12% { filter: blur(1.5px); letter-spacing: 0.08em; }
    18% { offset-distance: 100%; opacity: 0.9; transform: scale(0.55); filter: blur(0.5px); letter-spacing: 0.02em; }
    20% { offset-distance: 100%; opacity: 0; transform: scale(0.4); }
    21% { offset-distance: 0%; opacity: 0; transform: scale(0.9); filter: blur(0); }
    26% { offset-distance: 0%; opacity: 1; transform: scale(1); }
    100% { offset-distance: 0%; opacity: 1; transform: scale(1); letter-spacing: 0.02em; }
  }
  @keyframes owbob {
    from { transform: translateY(0); }
    to { transform: translateY(-6px); }
  }
  @keyframes landglow {
    0%, 18% { opacity: 0.35; transform: translateX(-50%) scale(1); }
    22% { opacity: 0.9; transform: translateX(-50%) scale(1.25); }
    28% { opacity: 0.4; transform: translateX(-50%) scale(1); }
    43% { opacity: 0.35; transform: translateX(-50%) scale(1); }
    47% { opacity: 0.9; transform: translateX(-50%) scale(1.25); }
    53% { opacity: 0.4; transform: translateX(-50%) scale(1); }
    68% { opacity: 0.35; transform: translateX(-50%) scale(1); }
    72% { opacity: 0.9; transform: translateX(-50%) scale(1.25); }
    78% { opacity: 0.4; transform: translateX(-50%) scale(1); }
    93% { opacity: 0.35; transform: translateX(-50%) scale(1); }
    97% { opacity: 0.9; transform: translateX(-50%) scale(1.25); }
    100% { opacity: 0.45; transform: translateX(-50%) scale(1.1); }
  }

  /* ---------- Compact story (below 1240px) ---------- */
  .hero-pair {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    margin-top: 12px;
  }
  .pair-words {
    position: relative;
    width: 130px;
    height: 60px;
  }
  .pair-word {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    font-family: var(--font-display);
    font-size: 27px;
    animation: cycleword 36s ease-in-out infinite;
  }
  .pw-1 { color: var(--rose); }
  .pw-2 { color: #b0743f; animation-delay: 9s; }
  .pw-3 { color: var(--muted-deep); animation-delay: 18s; }
  .pw-4 { color: var(--rose); animation-delay: 27s; }
  .pair-arrow {
    flex: none;
  }
  .pair-tiles {
    position: relative;
    width: 64px;
    height: 64px;
  }
  .pair-tiles .tile {
    border-radius: 18px;
    box-shadow: 0 6px 0 var(--red-shadow);
  }
  .hero-pair-captions {
    position: relative;
    width: 240px;
    height: 20px;
    margin: 2px auto 0;
  }

  @keyframes cycleword {
    0% { opacity: 0; filter: blur(8px); transform: translateY(8px); }
    4% { opacity: 1; }
    16% { opacity: 1; filter: blur(0); transform: none; }
    22%, 100% { opacity: 0; filter: blur(4px); transform: translateY(-8px); }
  }

  /* Must come after the base .hero-pair rules: hide the compact story on desktop */
  @media (min-width: 1240px) {
    .blush-hero .hero-pair,
    .blush-hero .hero-pair-captions {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .hero-content {
      padding-top: 36px;
    }
    .word-ghost {
      -webkit-text-stroke-width: 2px;
    }
    .hero-actions {
      flex-direction: column;
      align-self: stretch;
    }
    .hero-actions .btn {
      text-align: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .orbit-word,
    .ow-inner,
    .pair-word,
    .tile,
    .pair-caption,
    .landing-glow,
    .word-ghost,
    .word-solid {
      animation: none;
    }
    .word-ghost {
      background: none;
    }
    .squiggle-path {
      animation: none;
      stroke-dashoffset: 0;
    }
    .ow-love,
    .pw-1,
    .lt-1,
    .tile-1,
    .lc-1,
    .cap-1 {
      opacity: 1;
    }
    .ow-trust,
    .ow-care,
    .ow-purpose {
      opacity: 1;
    }
  }
</style>
