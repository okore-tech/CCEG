---
const year = new Date().getFullYear();
---

<footer class="blush-footer" id="contact">
  <span>© {year} Centre for Citizenship, Enterprise and Governance</span>
  <span>
    <a href="mailto:info@cceg.org.uk">info@cceg.org.uk</a> ·
    <a href="tel:+441443315343">+44 1443 315343</a>
  </span>
</footer>

<style>
  .blush-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding: 24px var(--pad) 30px;
    border-top: 1px solid var(--line);
    background: #ffffff;
    font-size: 13px;
    color: var(--muted);
  }
  .blush-footer a {
    text-decoration: none;
    color: var(--muted-deep);
  }

  @media (max-width: 560px) {
    .blush-footer {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
