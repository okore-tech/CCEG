<section class="cta-band" id="join" aria-label="Membership">
  <div class="cta-inner reveal">
    <h2>Ready to make the intangible tangible?</h2>
    <p>Join 320,000 members putting non-financial value to work in the real economy.</p>
    <div class="cta-actions">
      <a href="#" class="btn btn-solid">Become a member</a>
      <a href="mailto:info@cceg.org.uk" class="btn btn-ghost">Talk to us</a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    padding: 8px var(--pad) 64px;
  }
  .cta-inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: clamp(40px, 6vw, 72px) clamp(24px, 5vw, 64px);
    border-radius: 32px;
    background:
      radial-gradient(ellipse at 30% 0%, rgba(212, 43, 39, 0.14), transparent 60%),
      linear-gradient(135deg, rgba(212, 43, 39, 0.08), rgba(156, 24, 21, 0.05));
    border: 1px solid rgba(212, 43, 39, 0.22);
  }
  .cta-inner h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1.1;
    color: var(--text);
  }
  .cta-inner p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    max-width: 460px;
    color: var(--muted);
  }
  .cta-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 6px;
  }
</style>
