---
---

<section class="flow" id="approach" aria-label="From intangible to tangible" data-animate-scope>
  <p class="sr-only">
    Intangible value — love, trust, care, purpose — becomes tangible: love became a coffee, trust
    became a home, care became a meal, purpose became a pension.
  </p>
  <div class="flow-stage" aria-hidden="true">
    <span class="flow-label flow-label-left">intangible value</span>

    <div class="gas gas-1"></div>
    <div class="gas gas-2"></div>
    <div class="gas gas-3"></div>

    <div class="flow-words">
      <span class="flow-word fw-love">love</span>
      <span class="flow-word fw-trust">trust</span>
      <span class="flow-word fw-care">care</span>
      <span class="flow-word fw-purpose">purpose</span>
    </div>

    <div class="tangible-panel">
      <span class="flow-label flow-label-right">tangible</span>
      <div class="pair-objects">
        <div class="pair-obj po-1">
          <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M17 8h1a4 4 0 1 1 0 8h-1"></path><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"></path><line x1="6" y1="2" x2="6" y2="4"></line><line x1="10" y1="2" x2="10" y2="4"></line><line x1="14" y1="2" x2="14" y2="4"></line></svg>
        </div>
        <div class="pair-obj po-2">
          <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#100f10" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="m3 10.5 9-7.5 9 7.5"></path><path d="M5 10v10h14V10"></path><path d="M10 20v-6h4v6"></path></svg>
        </div>
        <div class="pair-obj po-3">
          <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16a8 8 0 0 1-16 0Z"></path><path d="M9 8c0-1.5 1-2 1-3"></path><path d="M14 8c0-1.5 1-2 1-3"></path></svg>
        </div>
        <div class="pair-obj po-4">
          <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="6" rx="7" ry="3"></ellipse><path d="M5 6v6c0 1.66 3.13 3 7 3s7-1.34 7-3V6"></path><path d="M5 12v6c0 1.66 3.13 3 7 3s7-1.34 7-3v-6"></path></svg>
        </div>
      </div>
      <div class="pair-captions">
        <span class="pair-caption pc-1">love became a coffee</span>
        <span class="pair-caption pc-2">trust became a home</span>
        <span class="pair-caption pc-3">care became a meal</span>
        <span class="pair-caption pc-4">purpose became a pension</span>
      </div>
    </div>
  </div>

  <!-- Compact intangible→tangible story for narrow screens -->
  <div class="flow-mobile" aria-hidden="true">
    <span class="flow-label fm-label">intangible value → tangible</span>
    <div class="fm-row">
      <div class="fm-words">
        <span class="fm-word fw-1">love</span>
        <span class="fm-word fw-2">trust</span>
        <span class="fm-word fw-3">care</span>
        <span class="fm-word fw-4">purpose</span>
      </div>
      <svg class="fm-arrow" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="12" x2="20" y2="12"></line><polyline points="13 5 20 12 13 19"></polyline></svg>
      <div class="fm-tiles">
        <div class="fm-tile ft-1">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M17 8h1a4 4 0 1 1 0 8h-1"></path><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"></path><line x1="6" y1="2" x2="6" y2="4"></line><line x1="10" y1="2" x2="10" y2="4"></line><line x1="14" y1="2" x2="14" y2="4"></line></svg>
        </div>
        <div class="fm-tile ft-2">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#100f10" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="m3 10.5 9-7.5 9 7.5"></path><path d="M5 10v10h14V10"></path><path d="M10 20v-6h4v6"></path></svg>
        </div>
        <div class="fm-tile ft-3">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16a8 8 0 0 1-16 0Z"></path><path d="M9 8c0-1.5 1-2 1-3"></path><path d="M14 8c0-1.5 1-2 1-3"></path></svg>
        </div>
        <div class="fm-tile ft-4">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="6" rx="7" ry="3"></ellipse><path d="M5 6v6c0 1.66 3.13 3 7 3s7-1.34 7-3V6"></path><path d="M5 12v6c0 1.66 3.13 3 7 3s7-1.34 7-3v-6"></path></svg>
        </div>
      </div>
    </div>
    <div class="fm-captions">
      <span class="fm-caption fc-1">love became a coffee</span>
      <span class="fm-caption fc-2">trust became a home</span>
      <span class="fm-caption fc-3">care became a meal</span>
      <span class="fm-caption fc-4">purpose became a pension</span>
    </div>
  </div>

</section>

<style>
  .flow {
    margin: 0 var(--pad) var(--section-gap);
  }
  .flow-stage {
    position: relative;
    height: 236px;
    overflow: hidden;
  }
  .flow-label {
    font-size: 11px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    font-weight: 700;
  }
  .flow-label-left {
    position: absolute;
    left: 16px;
    top: 34px;
    color: var(--muted);
  }

  .gas {
    position: absolute;
    border-radius: 50%;
  }
  .gas-1 {
    left: 0;
    top: 70px;
    width: 100px;
    height: 100px;
    background: radial-gradient(circle, rgba(232, 221, 210, 0.4), transparent 70%);
    filter: blur(12px);
    animation: gaswander1 7s ease-in-out infinite;
  }
  .gas-2 {
    left: 44px;
    top: 120px;
    width: 64px;
    height: 64px;
    background: radial-gradient(circle, rgba(232, 221, 210, 0.35), transparent 70%);
    filter: blur(10px);
    animation: gaswander2 8.5s ease-in-out infinite;
  }
  .gas-3 {
    left: -8px;
    top: 150px;
    width: 52px;
    height: 52px;
    background: radial-gradient(circle, rgba(216, 195, 165, 0.4), transparent 70%);
    filter: blur(9px);
    animation: gaswander1 9.5s ease-in-out 1.4s infinite;
  }

  /* Words fly along fixed 1328px-wide design paths. The layer is anchored to the
     right edge so the end of each path always lands on the tangible panel. */
  .flow-words {
    position: absolute;
    right: 0;
    top: 0;
    width: 1328px;
    height: 100%;
    pointer-events: none;
  }
  .flow-word {
    position: absolute;
    opacity: 0;
    font-family: var(--font-display);
    offset-rotate: 0deg;
    animation: pairword 36s ease-in infinite;
  }
  .fw-love {
    font-size: 30px;
    color: var(--bone);
    offset-path: path('M50,130 C320,60 580,200 850,120 C1060,70 1170,128 1216,128');
  }
  .fw-trust {
    font-size: 28px;
    color: var(--sand);
    offset-path: path('M40,160 C330,220 590,80 850,160 C1060,190 1170,132 1216,130');
    animation-delay: 9s;
  }
  .fw-care {
    font-size: 27px;
    color: var(--ember);
    offset-path: path('M56,110 C340,180 600,60 860,150 C1070,190 1180,130 1216,129');
    animation-delay: 18s;
  }
  .fw-purpose {
    font-size: 26px;
    color: var(--bone);
    offset-path: path('M44,180 C320,110 590,210 850,90 C1070,40 1180,126 1216,128');
    animation-delay: 27s;
  }

  .tangible-panel {
    position: absolute;
    right: 0;
    top: 44px;
    width: 170px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .flow-label-right {
    color: var(--red-300);
  }
  .pair-objects {
    position: relative;
    width: 96px;
    height: 96px;
  }
  .pair-obj {
    position: absolute;
    inset: 0;
    opacity: 0;
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: pairobj 36s ease-out infinite;
  }
  .po-1 { background: var(--red);     box-shadow: 0 12px 28px rgba(212, 43, 39, 0.45); }
  .po-2 { background: var(--bone);    box-shadow: 0 12px 28px rgba(232, 221, 210, 0.25); animation-delay: 9s; }
  .po-3 { background: var(--ember);   box-shadow: 0 12px 28px rgba(240, 83, 64, 0.4);   animation-delay: 18s; }
  .po-4 { background: var(--red-600); box-shadow: 0 12px 28px rgba(156, 24, 21, 0.5);   animation-delay: 27s; }
  .pair-captions {
    position: relative;
    width: 170px;
    height: 20px;
  }
  .pair-caption {
    position: absolute;
    inset: 0;
    opacity: 0;
    text-align: center;
    font-size: 13px;
    font-weight: 700;
    animation: pairobj 36s ease-out infinite;
  }
  .pc-1 { color: var(--red-300); }
  .pc-2 { color: var(--bone);    animation-delay: 9s; }
  .pc-3 { color: var(--ember);   animation-delay: 18s; }
  .pc-4 { color: var(--red-300); animation-delay: 27s; }

  /* Compact mobile story: word fades in, hands off to its tangible tile */
  .flow-mobile {
    display: none;
  }
  .fm-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 22px;
  }
  .fm-words {
    position: relative;
    width: 140px;
    height: 72px;
  }
  .fm-word {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    font-family: var(--font-display);
    font-size: 30px;
    animation: fmword 36s ease-in-out infinite;
  }
  .fw-1 { color: var(--bone); }
  .fw-2 { color: var(--sand); animation-delay: 9s; }
  .fw-3 { color: var(--ember); animation-delay: 18s; }
  .fw-4 { color: var(--bone); animation-delay: 27s; }
  .fm-arrow {
    color: var(--muted);
    flex: none;
  }
  .fm-tiles {
    position: relative;
    width: 72px;
    height: 72px;
  }
  .fm-tile {
    position: absolute;
    inset: 0;
    opacity: 0;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: pairobj 36s ease-out infinite;
  }
  .ft-1 { background: var(--red);     box-shadow: 0 10px 22px rgba(212, 43, 39, 0.45); }
  .ft-2 { background: var(--bone);    box-shadow: 0 10px 22px rgba(232, 221, 210, 0.25); animation-delay: 9s; }
  .ft-3 { background: var(--ember);   box-shadow: 0 10px 22px rgba(240, 83, 64, 0.4);   animation-delay: 18s; }
  .ft-4 { background: var(--red-600); box-shadow: 0 10px 22px rgba(156, 24, 21, 0.5);   animation-delay: 27s; }
  .fm-captions {
    position: relative;
    width: 100%;
    height: 20px;
  }
  .fm-caption {
    position: absolute;
    inset: 0;
    opacity: 0;
    text-align: center;
    font-size: 13px;
    font-weight: 700;
    animation: pairobj 36s ease-out infinite;
  }
  .fc-1 { color: var(--red-300); }
  .fc-2 { color: var(--bone); animation-delay: 9s; }
  .fc-3 { color: var(--ember); animation-delay: 18s; }
  .fc-4 { color: var(--red-300); animation-delay: 27s; }

  @keyframes fmword {
    0% { opacity: 0; filter: blur(8px); transform: translateY(8px); }
    4% { opacity: 1; }
    16% { opacity: 1; filter: blur(0); transform: none; }
    22%, 100% { opacity: 0; filter: blur(4px); transform: translateY(-8px); }
  }

  @media (max-width: 1239px) {
    .flow-stage {
      display: none;
    }
    .flow {
      margin-top: 34px;
    }
    .flow-mobile {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
      padding: 10px 0 34px;
    }
    .fm-label {
      color: var(--muted);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gas {
      animation: none;
    }
    .flow-words {
      display: none;
    }
    .pair-obj,
    .pair-caption,
    .fm-word,
    .fm-tile,
    .fm-caption {
      animation: none;
    }
    .po-1,
    .pc-1,
    .fw-1,
    .ft-1,
    .fc-1 {
      opacity: 1;
    }
  }
</style>
